URL: https://gonzalez-delgado.github.io/manifoldtest/,
    https://github.com/gonzalez-delgado/manifoldtest
BugReports: https://github.com/gonzalez-delgado/manifoldtest/issues
Encoding: UTF-8
Depends: R (>= 4.0.0)
Imports:
    stats,
    transport,
    energy,
    withr
